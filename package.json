{
  "name": "gdg-mod-loader",
  "version": "0.1.25",
  "private": true,
  "description": "Golden Days Gaming desktop mod loader for syncing supported game client mods with a server manifest.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "minecraft:stage": "node scripts/stage-minecraft-client.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:clean": "node scripts/cleanup-test-artifacts.cjs",
    "syntax:check": "node --check electron/main.cjs && node --check shared/gdg-sync-core.cjs && node --check server/gdg-sync-server.cjs && node --check scripts/publish-repo-pack.cjs && node --check scripts/stage-minecraft-client.cjs",
    "check": "npm run minecraft:stage && npm run test && npm run build && npm run syntax:check",
    "verify:release": "npm run test:clean && npm run check && npm run test:coverage && npm audit --audit-level=moderate && npm run test:clean",
    "package:win": "npm run minecraft:stage && npm run build && electron-builder --win dir",
    "package:win:portable": "npm run minecraft:stage && npm run build && electron-builder --win portable",
    "installer:win": "npm run minecraft:stage && npm run build && electron-builder --win nsis",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron .",
    "dev:fixture": "node scripts/create-dev-fixture.cjs",
    "repo:publish": "node scripts/publish-repo-pack.cjs",
    "server:publish": "node server/gdg-sync-server.cjs publish",
    "server:serve": "node server/gdg-sync-server.cjs serve",
    "server:dev": "node server/gdg-sync-server.cjs publish-and-serve"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yauzl": "^3.3.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.7",
    "concurrently": "^9.2.4",
    "electron": "^42.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.goldendaysgaming.modloader",
    "productName": "GDG Mod Loader",
    "afterPack": "scripts/after-pack-icon.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/icon.ico",
      "build/icon.png",
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "server-directory/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "target": [
        "dir"
      ]
    },
    "portable": {
      "artifactName": "GDG-Mod-Loader-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false,
      "artifactName": "GDG-Mod-Loader-${version}-setup.exe"
    }
  }
}
